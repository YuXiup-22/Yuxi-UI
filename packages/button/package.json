{
  "name": "@yuxi-ui/button",
  "version": "1.0.11",
  "private": false,
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "tsup": {
    "entry": [
      "src/index.ts"
    ],
    "splitting": false,
    "sourcemap": true,
    "clean": true
  },
  "scripts": {
    "build": "tsup  --format cjs,esm --dts",
    "dev": "tsup  --format cjs,esm --dts --watch",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "sass": "^1.89.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "antd-style": "catalog:",
    "classnames": "catalog:"
  }
}
